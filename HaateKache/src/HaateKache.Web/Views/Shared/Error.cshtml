@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<header class="page-head">
    <h1>Something went wrong</h1>
    <p>The page could not be completed. Your card details are not kept.</p>
    @if (Model.ShowRequestId)
    {
        <p class="quiet">Reference @Model.RequestId</p>
    }
</header>
<a class="button" asp-controller="Home" asp-action="Index">Back home</a>
