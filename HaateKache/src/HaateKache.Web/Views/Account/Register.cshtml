@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<header class="page-head">
    <p class="eyebrow">Shopper</p>
    <h1>Create an account</h1>
</header>
<form asp-action="Register" method="post" class="panel narrow">
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="flash flash-bad" role="alert">@Model.Error</p>
    }
    <label for="FullName">Full name</label>
    <input id="FullName" name="FullName" value="@Model.FullName" required />
    <label for="Email">Email</label>
    <input id="Email" name="Email" type="email" value="@Model.Email" required />
    <label for="Phone">Phone</label>
    <input id="Phone" name="Phone" value="@Model.Phone" />
    <label for="Password">Password</label>
    <input id="Password" name="Password" type="password" required />
    <label for="ConfirmPassword">Confirm password</label>
    <input id="ConfirmPassword" name="ConfirmPassword" type="password" required />
    <p class="quiet">At least 8 characters with upper and lower case, a number, and a symbol.</p>
    <button type="submit" class="button">Create account</button>
</form>
