@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1>Something went wrong</h1>
@if (Model.ShowRequestId)
{
    <p>Request ID: <code>@Model.RequestId</code></p>
}
<p class="lede">The clinic page did not finish. Go back and try the same step again.</p>
<p><a asp-page="/Index">Home</a></p>
